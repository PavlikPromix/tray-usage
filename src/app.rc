#include <windows.h>
#include "resource.h"
#pragma code_page(65001)
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Codex limits in the Windows notification area"
   VALUE "ProductName", "TrayUsage"
   VALUE "FileVersion", "1.1.0"
   VALUE "ProductVersion", "1.1.0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END

IDD_PROXY DIALOGEX 0, 0, 254, 122
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Прокси — TrayUsage"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Тип", -1, 8, 9, 36, 12
 COMBOBOX IDC_PROXY_TYPE, 52, 6, 194, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Адрес", IDC_PROXY_HOST_LABEL, 8, 27, 36, 12
 EDITTEXT IDC_PROXY_HOST, 52, 24, 117, 15, ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Порт", IDC_PROXY_PORT_LABEL, 175, 27, 25, 12
 EDITTEXT IDC_PROXY_PORT, 202, 24, 44, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
 CONTROL "Авторизация", IDC_PROXY_AUTH, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 52, 43, 194, 11
 LTEXT "Логин", IDC_PROXY_USER_LABEL, 8, 61, 36, 12
 EDITTEXT IDC_PROXY_USER, 52, 58, 194, 15, ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Пароль", IDC_PROXY_PASSWORD_LABEL, 8, 79, 36, 12
 EDITTEXT IDC_PROXY_PASSWORD, 52, 76, 194, 15, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "", IDC_PROXY_ERROR, 8, 98, 238, 28
 DEFPUSHBUTTON "Сохранить", IDOK, 118, 99, 64, 16
 PUSHBUTTON "Отмена", IDCANCEL, 188, 99, 58, 16
END
